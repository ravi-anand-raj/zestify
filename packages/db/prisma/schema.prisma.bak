generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String?
  status          UserStatus        @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  profile         UserProfile?
  subscriptions   Subscription[]
  accounts        Account[]
  conversations   AiConversation[]
  zestScores      ZestScore[]
  dailyNetWorth   DailyNetWorth[]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model UserProfile {
  id                     String  @id @default(uuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String?
  lastName               String?
  phoneNumber            String?
  riskTolerance          RiskTolerance @default(MODERATE)
  financialLiteracyLevel Int     @default(3)
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

model Institution {
  id           String    @id @default(uuid())
  plaidInsId   String?   @unique
  name         String
  logoUrl      String?
  accounts     Account[]
}

model Account {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId     String
  institution       Institution  @relation(fields: [institutionId], references: [id])
  plaidAccountId    String?      @unique
  name              String
  type              AccountType
  subtype           String?
  currentBalance    Decimal      @db.Decimal(15, 2)
  availableBalance  Decimal?     @db.Decimal(15, 2)
  currency          String       @default("USD")
  lastSyncedAt      DateTime     @default(now())
  
  transactions      Transaction[]
  holdings          Holding[]

  @@index([userId])
}

enum AccountType {
  DEPOSITORY
  CREDIT
  LOAN
  INVESTMENT
}

model Transaction {
  id                 String   @id @default(uuid())
  accountId          String
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidTransactionId String?  @unique
  amount             Decimal  @db.Decimal(15, 2)
  date               DateTime @db.Date
  merchantName       String?
  categoryPrimary    String?
  categoryDetailed   String?
  isSubscription     Boolean  @default(false)

  @@index([accountId])
  @@index([date])
}

model Security {
  id            String       @id @default(uuid())
  tickerSymbol  String       @unique
  name          String
  assetClass    AssetClass
  holdings      Holding[]
}

enum AssetClass {
  EQUITY
  CRYPTO
  FIXED_INCOME
  CASH
}

model Holding {
  id           String    @id @default(uuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  securityId   String
  security     Security  @relation(fields: [securityId], references: [id])
  quantity     Decimal   @db.Decimal(18, 8)
  costBasis    Decimal?  @db.Decimal(15, 2)
  currentValue Decimal   @db.Decimal(15, 2)
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayCustomerId     String?            @unique
  razorpaySubscriptionId String?
  tier                   SubscriptionTier   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime?
  
  billingHistory         BillingHistory[]
}

enum SubscriptionTier {
  FREE
  PRO
  INSTITUTIONAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model BillingHistory {
  id               String       @id @default(uuid())
  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount           Decimal      @db.Decimal(10, 2)
  status           BillingStatus
  invoiceDate      DateTime     @default(now())
}

enum BillingStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

model AiConversation {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime     @default(now())
  
  messages  AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String         @db.Text
  tokensUsed     Int?
  createdAt      DateTime       @default(now())

  @@index([createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ZestScore {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Int
  componentsJson Json?
  calculatedAt   DateTime @default(now())

  @@index([userId])
}

model DailyNetWorth {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  totalAssets      Decimal  @db.Decimal(15, 2)
  totalLiabilities Decimal  @db.Decimal(15, 2)
  netWorth         Decimal  @db.Decimal(15, 2)

  @@unique([userId, date])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  entityTable String
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
