// ============================================================================
// ZESTIFY — AI-Powered Financial Operating System
// Prisma Schema v1.0.0
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions", "views"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgcrypto, uuid_ossp]
}

// ════════════════════════════════════════════════════════════════════════════
//  ENUMS
// ════════════════════════════════════════════════════════════════════════════

enum SystemRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE_CONSERVATIVE
  MODERATE
  MODERATE_AGGRESSIVE
  AGGRESSIVE
}

enum InvestmentHorizon {
  SHORT_TERM       // < 1 year
  MEDIUM_TERM      // 1–3 years
  LONG_TERM        // 3–7 years
  VERY_LONG_TERM   // 7+ years
}

enum InvestmentExperience {
  BEGINNER
  INTERMEDIATE
  EXPERIENCED
  EXPERT
}

enum IncomeStability {
  VERY_STABLE
  STABLE
  MODERATE
  UNSTABLE
}

enum RiskCategory {
  LOW
  MODERATE_LOW
  MODERATE
  MODERATE_HIGH
  HIGH
}

enum GoalType {
  RETIREMENT
  HOME_PURCHASE
  EDUCATION
  EMERGENCY_FUND
  VACATION
  WEDDING
  CAR_PURCHASE
  DEBT_PAYOFF
  WEALTH_BUILDING
  CUSTOM
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum AssetType {
  STOCK
  MUTUAL_FUND
  ETF
  FIXED_DEPOSIT
  GOLD
  REAL_ESTATE
  CRYPTO
  PPF
  NPS
  EPF
  BOND
  CASH
  SAVINGS_ACCOUNT
  OTHER
}

enum PortfolioType {
  INVESTMENT
  RETIREMENT
  SAVINGS
  TAX_SAVING
  CUSTOM
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  SIP
  SWITCH_IN
  SWITCH_OUT
  SPLIT
  BONUS
  INTEREST
  DEPOSIT
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ConversationType {
  GENERAL
  PORTFOLIO_ANALYSIS
  GOAL_PLANNING
  TAX_OPTIMIZATION
  MARKET_INSIGHT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum NotificationType {
  PRICE_ALERT
  GOAL_MILESTONE
  PORTFOLIO_REBALANCE
  SIP_REMINDER
  PAYMENT_DUE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  MARKET_UPDATE
  AI_INSIGHT
  SYSTEM
  SECURITY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  BANK_TRANSFER
}

enum ReportType {
  PORTFOLIO_SUMMARY
  TAX_REPORT
  CAPITAL_GAINS
  MONTHLY_STATEMENT
  ANNUAL_REPORT
  CUSTOM
}

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportFormat {
  PDF
  CSV
  XLSX
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  SETTINGS_CHANGE
  SUBSCRIPTION_CHANGE
  IMPERSONATE
}

// ════════════════════════════════════════════════════════════════════════════
//  AUTHENTICATION & USERS
// ════════════════════════════════════════════════════════════════════════════

/// Core user identity. Handles authentication state and system-level role.
/// Extended profile data is stored in the Profile model.
model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique @db.VarChar(255)
  passwordHash  String?    @map("password_hash") @db.VarChar(255)
  emailVerified DateTime?  @map("email_verified")
  role          SystemRole @default(USER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @map("last_login_at")
  lastLoginIp   String?    @map("last_login_ip") @db.VarChar(45)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  // ── Relations ──
  accounts                Account[]
  sessions                Session[]
  profile                 Profile?
  riskProfile             RiskProfile?
  goals                   Goal[]
  portfolios              Portfolio[]
  transactions            Transaction[]
  watchlists              Watchlist[]
  healthScores            HealthScore[]
  aiConversations         AiConversation[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  subscription            Subscription?
  payments                Payment[]
  reports                 Report[]
  auditLogs               AuditLog[]       @relation("AuditUser")
  adminNotes              AdminNote[]       @relation("AdminNoteTarget")
  adminNotesAuthored      AdminNote[]       @relation("AdminNoteAuthor")

  @@index([email])
  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// OAuth / Social login accounts linked to a User (NextAuth.js compatible).
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @map("provider_account_id") @db.VarChar(255)
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type") @db.VarChar(50)
  scope             String? @db.VarChar(500)
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Active user sessions (NextAuth.js compatible).
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(500)
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Email verification and password reset tokens (NextAuth.js compatible).
model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(500)
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ════════════════════════════════════════════════════════════════════════════
//  PROFILE & RISK
// ════════════════════════════════════════════════════════════════════════════

/// Extended user profile with personal, financial, and KYC information.
/// One-to-one with User. Separated to keep auth model lean.
model Profile {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String         @unique @map("user_id") @db.Uuid
  firstName            String         @map("first_name") @db.VarChar(100)
  lastName             String         @map("last_name") @db.VarChar(100)
  displayName          String?        @map("display_name") @db.VarChar(100)
  avatarUrl            String?        @map("avatar_url") @db.VarChar(500)
  dateOfBirth          DateTime?      @map("date_of_birth") @db.Date
  gender               Gender?
  phone                String?        @db.VarChar(20)
  panNumber            String?        @map("pan_number") @db.VarChar(255) // Encrypted at application layer
  aadhaarLastFour      String?        @map("aadhaar_last_four") @db.VarChar(4)
  addressLine1         String?        @map("address_line_1") @db.VarChar(255)
  addressLine2         String?        @map("address_line_2") @db.VarChar(255)
  city                 String?        @db.VarChar(100)
  state                String?        @db.VarChar(100)
  pincode              String?        @db.VarChar(10)
  country              String         @default("IN") @db.VarChar(2)
  occupation           String?        @db.VarChar(100)
  employerName         String?        @map("employer_name") @db.VarChar(200)
  annualIncome         Decimal?       @map("annual_income") @db.Decimal(15, 2)
  incomeCurrency       String         @default("INR") @map("income_currency") @db.VarChar(3)
  maritalStatus        MaritalStatus? @map("marital_status")
  dependents           Int            @default(0)
  onboardingCompleted  Boolean        @default(false) @map("onboarding_completed")
  onboardingStep       Int            @default(0) @map("onboarding_step")
  timezone             String         @default("Asia/Kolkata") @db.VarChar(50)
  preferredCurrency    String         @default("INR") @map("preferred_currency") @db.VarChar(3)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@map("profiles")
}

/// Investment risk assessment derived from user questionnaire.
/// One active risk profile per user at any time. Historical records via isActive flag.
model RiskProfile {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String               @unique @map("user_id") @db.Uuid
  riskTolerance        RiskTolerance        @map("risk_tolerance")
  investmentHorizon    InvestmentHorizon    @map("investment_horizon")
  investmentExperience InvestmentExperience @map("investment_experience")
  incomeStability      IncomeStability      @map("income_stability")
  riskScore            Int                  @map("risk_score") @db.SmallInt // 0–100
  riskCategory         RiskCategory         @map("risk_category")
  assessmentDate       DateTime             @map("assessment_date")
  answers              Json                 // Full questionnaire response snapshot
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([riskCategory])
  @@map("risk_profiles")
}

// ════════════════════════════════════════════════════════════════════════════
//  GOALS
// ════════════════════════════════════════════════════════════════════════════

/// A financial goal with target amount, timeline, and tracking.
/// Goals can be linked to portfolios via GoalAllocation.
model Goal {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  name                 String       @db.VarChar(200)
  type                 GoalType
  targetAmount         Decimal      @map("target_amount") @db.Decimal(15, 2)
  currentAmount        Decimal      @default(0) @map("current_amount") @db.Decimal(15, 2)
  currency             String       @default("INR") @db.VarChar(3)
  targetDate           DateTime     @map("target_date") @db.Date
  startDate            DateTime     @map("start_date") @db.Date
  priority             GoalPriority @default(MEDIUM)
  status               GoalStatus   @default(ACTIVE)
  monthlyContribution  Decimal?     @map("monthly_contribution") @db.Decimal(12, 2)
  expectedReturnRate   Decimal?     @map("expected_return_rate") @db.Decimal(5, 2) // Annual %, e.g., 12.50
  inflationRate        Decimal      @default(6.00) @map("inflation_rate") @db.Decimal(5, 2)
  notes                String?      @db.Text
  iconName             String?      @map("icon_name") @db.VarChar(50)
  color                String?      @db.VarChar(7) // hex color
  metadata             Json?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations GoalAllocation[]

  @@index([userId, status])
  @@index([userId, type])
  @@index([targetDate])
  @@map("goals")
}

/// Maps a Goal to one or more Portfolios with allocation percentages.
/// Allows a single portfolio to serve multiple goals.
model GoalAllocation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId               String   @map("goal_id") @db.Uuid
  portfolioId          String   @map("portfolio_id") @db.Uuid
  allocationPercentage Decimal  @map("allocation_percentage") @db.Decimal(5, 2) // 0.00–100.00
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([goalId, portfolioId])
  @@map("goal_allocations")
}

// ════════════════════════════════════════════════════════════════════════════
//  ASSETS & PORTFOLIOS
// ════════════════════════════════════════════════════════════════════════════

/// System-defined asset classes (Equity, Debt, Gold, Real Estate, etc.).
/// Seeded at database initialization; not user-editable.
model AssetClass {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  iconName    String?  @map("icon_name") @db.VarChar(50)
  color       String?  @db.VarChar(7) // hex color
  riskLevel   Int      @map("risk_level") @db.SmallInt // 1 (low) – 5 (high)
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at")

  assets Asset[]

  @@map("asset_classes")
}

/// A tradeable or trackable financial instrument.
/// Can represent stocks, mutual funds, ETFs, FDs, gold, etc.
model Asset {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @db.VarChar(300)
  assetClassId     String    @map("asset_class_id") @db.Uuid
  type             AssetType
  symbol           String?   @db.VarChar(30)
  exchange         String?   @db.VarChar(20) // NSE, BSE, etc.
  isin             String?   @db.VarChar(12)
  currentPrice     Decimal?  @map("current_price") @db.Decimal(15, 4)
  previousClose    Decimal?  @map("previous_close") @db.Decimal(15, 4)
  dayChange        Decimal?  @map("day_change") @db.Decimal(15, 4)
  dayChangePercent Decimal?  @map("day_change_percent") @db.Decimal(8, 4)
  currency         String    @default("INR") @db.VarChar(3)
  lastPriceUpdate  DateTime? @map("last_price_update")
  logoUrl          String?   @map("logo_url") @db.VarChar(500)
  sector           String?   @db.VarChar(100)
  industry         String?   @db.VarChar(100)
  metadata         Json?     // Fund house, expense ratio, NAV history pointer, etc.
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  assetClass       AssetClass         @relation(fields: [assetClassId], references: [id])
  holdings         PortfolioHolding[]
  transactions     Transaction[]
  watchlistItems   WatchlistItem[]

  @@unique([symbol, exchange], map: "uq_asset_symbol_exchange")
  @@index([type])
  @@index([assetClassId])
  @@index([isin])
  @@index([isActive, type])
  @@map("assets")
}

/// A named collection of holdings owned by a user.
/// Each user has at least one default portfolio.
model Portfolio {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  name                 String        @db.VarChar(200)
  description          String?       @db.Text
  type                 PortfolioType @default(INVESTMENT)
  isDefault            Boolean       @default(false) @map("is_default")
  currency             String        @default("INR") @db.VarChar(3)
  totalInvested        Decimal       @default(0) @map("total_invested") @db.Decimal(15, 2)
  currentValue         Decimal       @default(0) @map("current_value") @db.Decimal(15, 2)
  totalReturns         Decimal       @default(0) @map("total_returns") @db.Decimal(15, 2)
  returnsPercentage    Decimal       @default(0) @map("returns_percentage") @db.Decimal(8, 4)
  dayChange            Decimal       @default(0) @map("day_change") @db.Decimal(15, 2)
  dayChangePercentage  Decimal       @default(0) @map("day_change_percentage") @db.Decimal(8, 4)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings        PortfolioHolding[]
  transactions    Transaction[]
  goalAllocations GoalAllocation[]

  @@index([userId, type])
  @@index([userId, isDefault])
  @@map("portfolios")
}

/// A specific asset holding within a portfolio, with aggregated cost and value.
/// Denormalized for fast portfolio dashboard reads.
model PortfolioHolding {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolioId           String    @map("portfolio_id") @db.Uuid
  assetId               String    @map("asset_id") @db.Uuid
  quantity              Decimal   @db.Decimal(18, 6) // Supports fractional shares / MF units
  avgBuyPrice           Decimal   @map("avg_buy_price") @db.Decimal(15, 4)
  investedValue         Decimal   @map("invested_value") @db.Decimal(15, 2)
  currentValue          Decimal   @map("current_value") @db.Decimal(15, 2)
  unrealizedGain        Decimal   @map("unrealized_gain") @db.Decimal(15, 2)
  unrealizedGainPercent Decimal   @map("unrealized_gain_percent") @db.Decimal(8, 4)
  weightPercentage      Decimal?  @map("weight_percentage") @db.Decimal(5, 2) // % of portfolio
  firstBuyDate          DateTime? @map("first_buy_date") @db.Date
  lastTransactionDate   DateTime? @map("last_transaction_date") @db.Date
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@unique([portfolioId, assetId], map: "uq_holding_portfolio_asset")
  @@index([assetId])
  @@map("portfolio_holdings")
}

// ════════════════════════════════════════════════════════════════════════════
//  TRANSACTIONS
// ════════════════════════════════════════════════════════════════════════════

/// Individual buy/sell/dividend/SIP transaction against a portfolio holding.
/// Immutable once status is COMPLETED; corrections are new offsetting transactions.
model Transaction {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  portfolioId      String            @map("portfolio_id") @db.Uuid
  assetId          String            @map("asset_id") @db.Uuid
  type             TransactionType
  quantity         Decimal           @db.Decimal(18, 6)
  price            Decimal           @db.Decimal(15, 4) // Per-unit price
  amount           Decimal           @db.Decimal(15, 2) // quantity × price
  fees             Decimal           @default(0) @db.Decimal(12, 2)
  tax              Decimal           @default(0) @db.Decimal(12, 2) // STT, GST, stamp duty
  totalAmount      Decimal           @map("total_amount") @db.Decimal(15, 2) // amount + fees + tax
  currency         String            @default("INR") @db.VarChar(3)
  transactionDate  DateTime          @map("transaction_date")
  settlementDate   DateTime?         @map("settlement_date")
  notes            String?           @db.Text
  referenceNumber  String?           @map("reference_number") @db.VarChar(100)
  status           TransactionStatus @default(COMPLETED)
  sipId            String?           @map("sip_id") @db.VarChar(100) // External SIP reference
  metadata         Json?             // Broker details, folio number, etc.
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id])
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@index([userId, transactionDate(sort: Desc)])
  @@index([portfolioId, transactionDate(sort: Desc)])
  @@index([assetId, transactionDate(sort: Desc)])
  @@index([userId, type])
  @@index([status])
  @@index([sipId])
  @@map("transactions")
}

// ════════════════════════════════════════════════════════════════════════════
//  WATCHLISTS
// ════════════════════════════════════════════════════════════════════════════

/// User-defined watchlist for tracking securities of interest.
model Watchlist {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

/// Individual tracked asset within a watchlist, with optional price alerts.
model WatchlistItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchlistId     String   @map("watchlist_id") @db.Uuid
  assetId         String   @map("asset_id") @db.Uuid
  addedPrice      Decimal? @map("added_price") @db.Decimal(15, 4)  // Price when added
  alertAbovePrice Decimal? @map("alert_above_price") @db.Decimal(15, 4)
  alertBelowPrice Decimal? @map("alert_below_price") @db.Decimal(15, 4)
  notes           String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id])

  @@unique([watchlistId, assetId], map: "uq_watchlist_asset")
  @@index([assetId])
  @@map("watchlist_items")
}

// ════════════════════════════════════════════════════════════════════════════
//  HEALTH SCORES
// ════════════════════════════════════════════════════════════════════════════

/// Periodic financial health assessment with component-level scoring.
/// Generated by AI pipeline; immutable once created (append-only history).
model HealthScore {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  overallScore        Int      @map("overall_score") @db.SmallInt // 0–100
  savingsScore        Int      @map("savings_score") @db.SmallInt
  debtScore           Int      @map("debt_score") @db.SmallInt
  investmentScore     Int      @map("investment_score") @db.SmallInt
  insuranceScore      Int      @map("insurance_score") @db.SmallInt
  taxScore            Int      @map("tax_score") @db.SmallInt
  emergencyFundScore  Int      @map("emergency_fund_score") @db.SmallInt
  assessmentDate      DateTime @map("assessment_date") @db.Date
  recommendations     Json     // Array of actionable recommendations
  breakdown           Json     // Detailed scoring methodology and inputs
  previousScore       Int?     @map("previous_score") @db.SmallInt // For trend display
  scoreChange         Int?     @map("score_change") @db.SmallInt   // Delta from previous
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentDate(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("health_scores")
}

// ════════════════════════════════════════════════════════════════════════════
//  AI CONVERSATIONS
// ════════════════════════════════════════════════════════════════════════════

/// A conversational thread with the AI Copilot.
/// Supports multiple conversation types (portfolio analysis, tax planning, etc.).
model AiConversation {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  title       String?            @db.VarChar(300)
  type        ConversationType   @default(GENERAL)
  status      ConversationStatus @default(ACTIVE)
  totalTokens Int                @default(0) @map("total_tokens")
  modelUsed   String?            @map("model_used") @db.VarChar(50)
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, type])
  @@map("ai_conversations")
}

/// Individual message within an AI conversation.
/// Supports user, assistant, system, and tool-result roles.
model AiMessage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String        @db.Text
  toolCalls      Json?         @map("tool_calls")   // Array of tool invocations
  toolResults    Json?         @map("tool_results")  // Results from tool calls
  metadata       Json?         // Model version, temperature, etc.
  tokenCount     Int?          @map("token_count")
  latencyMs      Int?          @map("latency_ms") // Response generation time
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ════════════════════════════════════════════════════════════════════════════
//  NOTIFICATIONS
// ════════════════════════════════════════════════════════════════════════════

/// User-facing notification record across all delivery channels.
model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String              @db.VarChar(300)
  body      String              @db.Text
  data      Json?               // Structured payload (entity IDs, amounts, etc.)
  actionUrl String?             @map("action_url") @db.VarChar(500)
  imageUrl  String?             @map("image_url") @db.VarChar(500)
  isRead    Boolean             @default(false) @map("is_read")
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  expiresAt DateTime?           @map("expires_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([expiresAt])
  @@map("notifications")
}

/// Per-user, per-notification-type delivery channel preferences.
model NotificationPreference {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  emailEnabled Boolean          @default(true) @map("email_enabled")
  pushEnabled  Boolean          @default(true) @map("push_enabled")
  inAppEnabled Boolean          @default(true) @map("in_app_enabled")
  smsEnabled   Boolean          @default(false) @map("sms_enabled")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type], map: "uq_notification_pref_user_type")
  @@map("notification_preferences")
}

// ════════════════════════════════════════════════════════════════════════════
//  SUBSCRIPTIONS & PAYMENTS
// ════════════════════════════════════════════════════════════════════════════

/// Platform subscription plans (FREE, PRO, ELITE).
/// Managed by admin; referenced by user subscriptions.
model Plan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  slug         String   @unique @db.VarChar(100)
  description  String?  @db.Text
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice  Decimal  @map("yearly_price") @db.Decimal(10, 2)
  currency     String   @default("INR") @db.VarChar(3)
  features     Json     @default("[]")  // Array of feature strings
  limits       Json     @default("{}") // { maxPortfolios, maxGoals, aiTokensPerMonth, ... }
  trialDays    Int      @default(0) @map("trial_days")
  isActive     Boolean  @default(true) @map("is_active")
  isPopular    Boolean  @default(false) @map("is_popular")
  sortOrder    Int      @default(0) @map("sort_order") @db.SmallInt
  razorpayPlanIdMonthly String? @map("razorpay_plan_id_monthly") @db.VarChar(100)
  razorpayPlanIdYearly  String? @map("razorpay_plan_id_yearly") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

/// A user's active subscription to a plan.
/// One active subscription per user (enforced by unique constraint).
model Subscription {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String             @unique @map("user_id") @db.Uuid
  planId                  String             @map("plan_id") @db.Uuid
  status                  SubscriptionStatus @default(TRIALING)
  billingCycle            BillingCycle       @default(MONTHLY) @map("billing_cycle")
  razorpaySubscriptionId  String?            @map("razorpay_subscription_id") @db.VarChar(100)
  razorpayCustomerId      String?            @map("razorpay_customer_id") @db.VarChar(100)
  currentPeriodStart      DateTime           @map("current_period_start")
  currentPeriodEnd        DateTime           @map("current_period_end")
  trialStart              DateTime?          @map("trial_start")
  trialEnd                DateTime?          @map("trial_end")
  cancelledAt             DateTime?          @map("cancelled_at")
  cancelReason            String?            @map("cancel_reason") @db.VarChar(500)
  metadata                Json?
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([razorpaySubscriptionId])
  @@map("subscriptions")
}

/// Individual payment transaction processed via Razorpay.
/// Linked to subscriptions for recurring billing or standalone for one-time charges.
model Payment {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  subscriptionId      String?       @map("subscription_id") @db.Uuid
  razorpayPaymentId   String?       @unique @map("razorpay_payment_id") @db.VarChar(100)
  razorpayOrderId     String?       @map("razorpay_order_id") @db.VarChar(100)
  razorpaySignature   String?       @map("razorpay_signature") @db.VarChar(500)
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("INR") @db.VarChar(3)
  status              PaymentStatus @default(CREATED)
  method              PaymentMethod?
  description         String?       @db.VarChar(500)
  receiptUrl          String?       @map("receipt_url") @db.VarChar(500)
  failureReason       String?       @map("failure_reason") @db.VarChar(500)
  idempotencyKey      String?       @unique @map("idempotency_key") @db.VarChar(100)
  metadata            Json?
  paidAt              DateTime?     @map("paid_at")
  refundedAt          DateTime?     @map("refunded_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([razorpayOrderId])
  @@map("payments")
}

// ════════════════════════════════════════════════════════════════════════════
//  REPORTS
// ════════════════════════════════════════════════════════════════════════════

/// Generated financial report (PDF, CSV, XLSX).
/// Created asynchronously via BullMQ job queue.
model Report {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  type         ReportType
  title        String       @db.VarChar(300)
  status       ReportStatus @default(QUEUED)
  fileUrl      String?      @map("file_url") @db.VarChar(500)
  fileSize     Int?         @map("file_size") // bytes
  format       ReportFormat @default(PDF)
  parameters   Json?        // Date range, portfolio IDs, filters used
  generatedAt  DateTime?    @map("generated_at")
  expiresAt    DateTime?    @map("expires_at")
  errorMessage String?      @map("error_message") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("reports")
}

// ════════════════════════════════════════════════════════════════════════════
//  ADMIN & SYSTEM
// ════════════════════════════════════════════════════════════════════════════

/// Immutable audit trail for all security-sensitive and data-mutating operations.
/// Retained for compliance; never deleted or updated.
model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  entityType String      @map("entity_type") @db.VarChar(100) // e.g., "User", "Portfolio", "Transaction"
  entityId   String      @map("entity_id") @db.VarChar(36)
  action     AuditAction
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.VarChar(500)
  sessionId  String?     @map("session_id") @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Global platform configuration key-value store.
/// Used for feature toggles, maintenance mode, rate limit config, etc.
model SystemSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(200)
  value       Json
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public") // Exposed to client apps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// Feature flag for gradual rollout and A/B testing.
model FeatureFlag {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String   @unique @db.VarChar(200)
  description       String?  @db.Text
  isEnabled         Boolean  @default(false) @map("is_enabled")
  rolloutPercentage Int      @default(0) @map("rollout_percentage") @db.SmallInt // 0–100
  conditions        Json?    // { userRoles: [], planTiers: [], userIds: [] }
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Internal admin notes attached to a user account.
/// Used for support escalations, investigations, and compliance.
model AdminNote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId      String   @map("admin_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  admin      User @relation("AdminNoteAuthor", fields: [adminId], references: [id])
  targetUser User @relation("AdminNoteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([adminId])
  @@map("admin_notes")
}
